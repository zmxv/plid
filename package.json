{
  "name": "plid",
  "version": "1.0.0",
  "description": "Prefix-Lexicographic ID — variable-width, lexicographically sortable identifiers with a 46-bit millisecond timestamp and a 2-bit local-date offset",
  "keywords": [
    "id",
    "uuid",
    "ulid",
    "sortable",
    "lexicographic",
    "monotonic",
    "primary-key",
    "timestamp"
  ],
  "homepage": "https://github.com/zmxv/plid",
  "bugs": {
    "url": "https://github.com/zmxv/plid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmxv/plid.git"
  },
  "license": "MIT",
  "author": "Zhen Wang <z@zmxv.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
